# Datenbanken — zu groß und zu volatil für Git, bleiben lokal
*.db
*.db-wal
*.db-shm
*.db.init.lock
.imc-publish-guard-*.sentinel

# Logs
*.log

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.pytest_tmp/
.reset_test_tmp/

# Node
node_modules/
package-lock.json.bak

# Secrets / verschlüsselte Schlüssel (DPAPI ist an diesen Windows-Account gebunden,
# ein Transfer über Git wäre ohnehin nutzlos und riskant)
*.dpapi
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Retained local legacy Git write proxies: never used for repository writes.
/TOOLS/GIT_WRITE_SHIM/
/TOOLS/Git-WriteBroker.ps1
/TOOLS/Invoke-IMC-GitWriteBroker.ps1
/TOOLS/ASTRA_ADVISOR_SHIM/imc-git-write.cmd

